# Local, air-gapped default.
LLM_PROVIDER=ollama
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_REQUEST_TIMEOUT=360

# Optional online provider comparison.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Chunking and retrieval.
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4


# CHROMA VECTOR DB
COLLECTION_NAME="technical_evidence"

# Cross-encoder reranker for hybrid mode (fastembed/ONNX, ~80 MB, downloaded once to storage/models).
# Leave empty to keep plain fusion order.
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2


# Optional OCR. Missing system tools affect only images/scanned PDF pages.
OCR_ENABLED=true
OCR_MIN_CHARS=40
OCR_DPI=300
OCR_LANGUAGE=eng
